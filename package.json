{
  "name": "campus-assistant",
  "version": "0.8.0",
  "description": "班集桌面应用",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cd student-frontend && npm run dev",
    "electron": "electron .",
    "electron:dev": "concurrently --names \"Vite,Electron\" --prefix-colors \"blue,green\" --kill-others \"npm run dev\" \"electron .\"",
    "inp": "node scripts/inp-probe.mjs",
    "build": "cd student-frontend && npm run build",
    "build:win:inno": "node electron/inno/compile.mjs",
    "electron:build": "npm run build && electron-builder --dir && npm run build:win:inno",
    "postinstall": "cd student-backend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "koffi": "^3.3.3",
    "mammoth": "^1.12.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.3",
    "trash": "^10.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^10.0.4",
    "electron": "43.4.1",
    "electron-builder": "^24.13.0",
    "wait-on": "^9.1.0"
  }
}
