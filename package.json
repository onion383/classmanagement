{
  "name": "campus-assistant",
  "version": "0.8.0",
  "description": "班集桌面应用",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "cd student-frontend && npm run dev",
    "electron": "electron .",
    "electron:dev": "concurrently --names \"Vite,Electron\" --prefix-colors \"blue,green\" --kill-others \"npm run dev\" \"electron .\"",
    "inp": "node testjs/inp-probe.mjs",
    "seed": "node testjs/seed-test-data.js",
    "test:units": "node --test \"testjs/units/*.test.js\"",
    "build": "cd student-frontend && npm run build",
    "build:win:inno": "node electron/inno/compile.mjs",
    "electron:build": "npm run build && electron-builder --dir && npm run build:win:inno",
    "postinstall": "cd student-backend && npm install"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  }
}
