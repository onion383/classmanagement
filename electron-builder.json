{
  "appId": "com.example.campus-assistant",
  "productName": "班集",
  "electronLanguages": ["zh-CN", "en-US"],
  "directories": {
    "output": "release4"
  },
  "files": [
    "electron/**/*",
    "!electron/afterPack.js",
    "student-frontend/dist/**/*",
    "student-backend/**/*",
    "!student-backend/data/**",
    "!student-backend/uploads/**",
    "resources/ffmpeg/**/*",
    "!**/node_modules/better-sqlite3-multiple-ciphers/deps/**",
    "!**/node_modules/better-sqlite3-multiple-ciphers/src/**",
    "!**/node_modules/better-sqlite3-multiple-ciphers/binding.gyp",
    "!**/node_modules/better-sqlite3-multiple-ciphers/README.md",
    "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/linux*.node",
    "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*.node",
    "!**/node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-arm64.node",
    "!**/node_modules/pdfjs-dist/**",
    "!**/node_modules/@napi-rs/**",
    "!student-frontend/dist/glass-bg.jpg",
    "!student-frontend/dist/NotoSansSC-6.ttf",
    "!**/node_modules/pdf-parse/dist/pdf-parse/web/**",
    "!**/node_modules/pdf-parse/dist/pdf-parse/esm/**",
    "!**/node_modules/pdf-parse/dist/worker/**",
    "!**/node_modules/pdf-parse/dist/node/**",
    "!**/node_modules/pdf-parse/bin/**",
    "!**/node_modules/mammoth/mammoth.browser.js",
    "!**/node_modules/mammoth/mammoth.browser.min.js",
    "!**/node_modules/mammoth/test/**",
    "!**/node_modules/jszip/dist/**",
    "!**/node_modules/xlsx/dist/xlsx.*",
    "!**/node_modules/xlsx/dist/cpexcel.full.mjs",
    "!**/node_modules/xlsx/xlsx.mjs",
    "!**/node_modules/xlsx/formats.png",
    "!**/node_modules/trash/lib/macos-trash",
    "!**/node_modules/pdf-parse/dist/pdf-parse/cjs/pdf.worker.mjs",
    "!**/node_modules/codepage/bin/**",
    "!**/node_modules/koffi/src/**",
    "!**/node_modules/koffi/vendor/**",
    "!**/node_modules/koffi/cnoke.cjs",
    "!**/node_modules/**/*.h",
    "!**/node_modules/**/*.hpp",
    "!**/node_modules/**/*.hh",
    "!**/node_modules/**/*.md",
    "!**/*.map",
    "!**/*.d.ts",
    "package.json"
  ],
  "asarUnpack": [
    "resources/ffmpeg/**/*",
    "**/student-backend/**",
    "node_modules/**/*",
    "**/*.node"
  ],
  "compression": "maximum",
  "afterPack": "electron/afterPack.js",
  "npmRebuild": false,
  "win": {
    "target": "dir",
    "icon": "student-frontend/public/logo-icon.png"
  },
  "mac": {
    "target": "dmg",
    "icon": "student-frontend/public/logo-icon.png"
  }
}
