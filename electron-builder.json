{
  "appId": "com.example.campus-assistant",
  "productName": "班级管理系统",
  "directories": {
    "output": "release4",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "student-frontend/dist/**/*",
    "student-backend/**/*",
    "!student-backend/data/**",
    "!student-backend/uploads/**",
    "resources/ffmpeg/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "resources/ffmpeg/**/*",
    "**/student-backend/**",
    "node_modules/**/*",
    "**/*.node"
  ],
  "compression": "maximum",
  "npmRebuild": false,
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg",
    "icon": "student-frontend/public/favicon.svg"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
