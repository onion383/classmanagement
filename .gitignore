# Node
node_modules/
node_modules_old/
dist/
dist_empty/

# 环境变量
.env
.env.*
!.env.example

# JWT 密钥文件
.jwt-secret

# TLS 私钥/证书（Vite 开发用自签，不入库）
key.pem
cert.pem
*.pem
*.key

# 上传文件夹（图片）
*/uploads/

# 数据目录（数据库、缩略图缓存等运行时数据）
*/data/

# 打包产物
release*/
dist/
dist-verify*/
*.exe
# 例外：随包分发的 FFmpeg LGPL 自编译版本（exe + 构建脚本 + 许可证 + 构建信息）需入库，
# 避免每次重新编译；以后新增 ffprobe.exe / dll 也会一并入库
!resources/ffmpeg/
!resources/ffmpeg/*

# 操作系统文件
.DS_Store
Thumbs.db

# 测试数据
*.db
# SQLite WAL/SHM 运行时边车文件（避免误提交）
*-shm
*-wal



# 测试脚本与单元测试（入库）；仅忽略运行时测量产物（含密钥/缓存/日志）
testjs/.startup-measure/

# 问题/优化管理文档（仅本地，不入库）
doc/problem.md

# 设计和支付原图（需要入库，勿忽略）
!student-frontend/origin/
!student-frontend/origin/*

# 缓存
.vite/
.perf-data/
.trae/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# AI 助手本地记忆（不入库）
.workbuddy/
.tmp-crops/
.perf-data/
.issverify/
.trae/
