# Node
node_modules/
node_modules_old/
dist/
dist_empty/

# 环境变量
.env
.env.*
!.env.example

# JWT 密钥文件
.jwt-secret

# TLS 私钥/证书（Vite 开发用自签，不入库）
key.pem
cert.pem
*.pem
*.key

# 上传文件夹（图片）
*/uploads/

# 数据目录（数据库、缩略图缓存等运行时数据）
*/data/

# 打包产物
release*/
dist-verify*/
*.exe
# 例外：随包分发的 FFmpeg LGPL 自编译版本（exe + 构建脚本 + 许可证 + 构建信息）需入库，
# 避免每次重新编译；以后新增 ffprobe.exe / dll 也会一并入库
!resources/ffmpeg/
!resources/ffmpeg/*

# 操作系统文件
.DS_Store
Thumbs.db

# 测试数据
*.db
# SQLite WAL/SHM 运行时边车文件（避免误提交）
*-shm
*-wal
# 数据库衍生文件：rekey 转换期间的临时备份（dbManager.backup.js 生成，形如 <db>.rekey-backup）、
# 明文导出副本与整体备份目录。这些可能是不加密的明文库，绝不入库。
# 注意：仅写 *.db 不足以覆盖 *.db.rekey-backup 这类带后缀的文件名。
*.rekey-backup
*.db.bak
*.db-*
*.plain.bak
.db-backup-*/
db-backup-*/



# 测试脚本与单元测试（入库）；仅忽略运行时测量产物（含密钥/缓存/日志）
testjs/.startup-measure/
# 本地性能诊断临时实验脚本（不入库，可随时删除）
testjs/tmp/

# 本地性能基准页（不入库）：dev 下手动打开测量用，需随项目源码实时改动才有意义，
# 且不属于产品功能。与 perf-bench.html / sticky-test.html 同类。
student-frontend/*-bench.html
student-frontend/sticky-test.html

# 开发文档目录（仅本地，不入库）。原先零散的 problem.md / GitHub孤立对象清除工单.md
# 以及 Structure.md、优化计划.md、优化文档.md、MCP接入方案.md 已统一收进此目录。
# 该目录含泄漏 blob SHA 清单等敏感内容，绝不入库。
doc/开发文档/

# 设计和支付原图（需要入库，勿忽略）
!student-frontend/origin/
!student-frontend/origin/*

# 缓存
.vite/
.perf-data/
.trae/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# AI 助手本地记忆（不入库）
.workbuddy/
.tmp-crops/
.issverify/
